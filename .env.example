# Jelly Leon — omgevingsvariabelen (ALLEEN ontwikkeling/CI; géén echte waarden, géén geheimen).
# De standaard TrueNAS Custom App heeft GEEN verplichte variabelen (deploy/truenas/CUSTOM_APP.md):
# de image zet zelf de upstream-standaarden hieronder. Overschrijven is zelden nodig.

# Datamappen (standaard uit de upstream-runtime-image; houd ze gelijk aan de mounts /config en /cache)
JELLYFIN_DATA_DIR=/config
JELLYFIN_CONFIG_DIR=/config/config
JELLYFIN_LOG_DIR=/config/log
JELLYFIN_CACHE_DIR=/cache
JELLYFIN_WEB_DIR=/jellyfin/jellyfin-web
JELLYFIN_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg


# Alleen in de bouwomgeving achter een TLS-proxy (nooit in een Dockerfile of het formulier):
# HTTPS_PROXY=<proxy-url>
