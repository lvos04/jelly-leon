<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Testnamen met underscores (Methode_Situatie_Verwachting) zijn hier gewenst. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Tests hebben de runtime-assemblies wél nodig (de plugin zelf niet). -->
    <PackageReference Include="Jellyfin.Controller" />
    <PackageReference Include="Jellyfin.Model" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Jellyfin.Plugin.JellyLeon/Jellyfin.Plugin.JellyLeon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../../docs/openapi/jelly-leon-plugin.openapi.json" Link="jelly-leon-plugin.openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
