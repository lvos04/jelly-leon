<Project>
  <!-- Eigen centrale pakketversies voor plugins; stopt overerving van ../Directory.Packages.props (ADR-0002). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Publieke plugin-ABI: altijd exact de versie van de forkbasis. -->
    <PackageVersion Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageVersion Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <!-- SQLite: dezelfde versie als de host (stock 12.4 en de fork leveren Microsoft.Data.Sqlite 10.0.x mee).
         De plugin bouwt tegen .Core zonder runtime-assets; alleen de tests nemen de bundel met de native bibliotheek. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Testpakketten: dezelfde versies als upstream (Directory.Packages.props in de root; 12.4: xunit.v3). -->
    <!-- Alleen in de tests: een tweede, onafhankelijke Ed25519-implementatie om Hub-tokens te tekenen. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Moq" Version="4.18.4" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
