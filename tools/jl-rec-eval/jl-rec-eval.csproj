<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Zelfde bron als de plugin, zonder Jellyfin-runtime of kopie van de engine. -->
    <Compile Include="../../plugins/JellyLeon/src/Jellyfin.Plugin.JellyLeon/Modules/Recommendations/Engine/*.cs" Link="Engine/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
